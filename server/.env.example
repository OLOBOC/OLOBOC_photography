# Server Environment Configuration
PORT=4000
NODE_ENV=production
# In production, use PostgreSQL e.g.: postgresql://user:password@localhost:5432/oloboc_db?schema=public
DATABASE_URL="file:./dev.db"
JWT_SECRET="generate_a_cryptographically_secure_random_64_char_key_here"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Client Origin for CORS
CLIENT_URL="https://oloboc.com"

# Storage Configuration (local or s3)
STORAGE_DRIVER="local" # "local" or "s3"
UPLOAD_DIR="./storage"

# S3 / Cloudflare R2 Credentials (when STORAGE_DRIVER=s3)
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME="oloboc-photos"
# S3_REGION="auto"

# Initial Admin Credentials (used during database seed)
ADMIN_INITIAL_EMAIL="admin@oloboc.com"
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction123!"

# Contact & Notifications
CONTACT_FORWARD_EMAIL="contacto@oloboc.com"
# SMTP Configuration (optional for transactional emails)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="notifications@oloboc.com"
# SMTP_PASS="secure_password"
