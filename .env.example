# ==============================================================================
# OLOBOC_ MOTORSPORT — PLANTILLA DE VARIABLES DE ENTORNO (PRODUCCIÓN / DESARROLLO)
# ==============================================================================
# Copie este archivo como .env tanto en /server como en la raíz del entorno
# IMPORTANTE: Nunca suba archivos .env con credenciales reales al repositorio git.

# --- 1. ENTORNO Y SERVIDOR ---
NODE_ENV=production
PORT=4000
BASE_URL=https://oloboc.com
CLIENT_URL=https://oloboc.com

# --- 2. BASE DE DATOS ---
# Para desarrollo local (SQLite):
DATABASE_URL="file:./dev.db"
# Para producción (PostgreSQL recomendado en VPS / RDS):
# DATABASE_URL="postgresql://oloboc_user:STRONG_PASSWORD@localhost:5432/oloboc_db?schema=public"

# --- 3. AUTENTICACIÓN Y SEGURIDAD JWT ---
# Genere una clave segura de al menos 64 caracteres: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_TO_A_64_CHAR_HEX_OR_BASE64_KEY
JWT_EXPIRES_IN=24h
ADMIN_EMAIL=admin@oloboc.com
ADMIN_INITIAL_PASSWORD=Change_This_Password_Immediately_2026!

# --- 4. PASARELA DE PAGO (STRIPE) ---
# Obtenga estas claves desde el Dashboard de Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=TU_CLAVE_SECRETA_STRIPE_AQUI
STRIPE_WEBHOOK_SECRET=TU_FIRMA_WEBHOOK_STRIPE_AQUI

# --- 5. ALMACENAMIENTO DE FOTOGRAFÍAS (HÍBRIDO / S3 / CLOUDFLARE R2) ---
# Dejar vacío para almacenamiento local en disco (/server/storage)
STORAGE_DIR=./storage
S3_BUCKET=oloboc-photos-production
S3_REGION=eu-west-1
# Para Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# CDN público para thumbnails y previews protegidas (opcional):
S3_PUBLIC_CDN_URL=

# --- 6. CORREO TRANSACCIONAL (SMTP) ---
# Dejar vacío para modo simulación (registra en BD sin enviar)
SMTP_HOST=smtp.servidor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@oloboc.com
SMTP_PASS=PASSWORD_SMTP_AQUI
SMTP_FROM="OLOBOC_ Motorsport <notificaciones@oloboc.com>"

# --- 7. INTELIGENCIA ARTIFICIAL & OCR ---
# Idiomas soportados por Tesseract (spa, eng)
OCR_LANGUAGES=spa+eng
# Habilitar worker Python YOLOv8 en segundo plano (true/false)
AI_ENABLE_PYTHON_WORKER=false
